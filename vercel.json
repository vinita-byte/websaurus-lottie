{
  "cleanUrls": false,
  "headers": [
    { "source": "/(.*)\\.lottie", "headers": [{ "key": "Content-Type", "value": "application/zip" }] },
    { "source": "/(.*)\\.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/(lottie|exports)/(.*)", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }, { "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
